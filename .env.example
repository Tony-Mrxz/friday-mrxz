# Friday AI Environment Configuration

# GitHub Models API Token (Free from github.com/settings/tokens)
GITHUB_TOKEN=your_github_token_here

# Groq API Key (Free from console.groq.com for ultra-fast Llama 70B & Whisper STT)
GROQ_API_KEY=your_groq_api_key_here

# Telegram Bot Token (From @BotFather)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Authorized Telegram User IDs (comma-separated for security lock)
AUTHORIZED_USER_IDS=123456789

# WebRTC Server Port
WEBRTC_PORT=8000
